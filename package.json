{
  "name": "dsh-plugin-im",
  "version": "4.13.0+windbuddy.3",
  "description": "有风 Buddy 内置 IM 机器人：飞书扫码创建应用、申请办公权限、长连接收发消息，并连接本机 DSH。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-agent",
    "im",
    "instant-messaging",
    "chatbot",
    "feishu",
    "lark",
    "wechat",
    "wecom",
    "dingtalk",
    "qq",
    "slack",
    "telegram",
    "discord",
    "whatsapp",
    "ai-office"
  ],
  "author": "xmanrui (https://github.com/xmanrui)",
  "contributors": [
    {
      "name": "C3H3-AI",
      "url": "https://github.com/C3H3-AI"
    },
    {
      "name": "divingleee",
      "url": "https://github.com/divingleee"
    },
    {
      "name": "Chan-0312",
      "url": "https://github.com/Chan-0312"
    }
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmanrui/dsh-im.git"
  },
  "homepage": "https://github.com/xmanrui/dsh-im#readme",
  "bugs": {
    "url": "https://github.com/xmanrui/dsh-im/issues"
  },
  "bin": {
    "dsh-im": "bin/dsh-im.mjs"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "bin",
    "cordis.patch.yml",
    "lib",
    "plugin-src",
    "scripts",
    "src",
    "PROACTIVE_DELIVERY.md",
    "PROACTIVE_DELIVERY.en.md",
    "LICENSE",
    "README.md",
    "README.en.md",
    "THIRD_PARTY_NOTICES.md",
    "FORK.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.1.2-alpha.1 || 0.1.2-alpha.4 || 0.1.2-alpha.5 || 0.1.2-rc.1 || 0.1.3-alpha.1 || 0.2.0-rc.2",
      "dshReleases": {
        "0.1.2-alpha.1": "compatible",
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.1": "compatible",
        "0.2.0-rc.2": "compatible"
      },
      "profiles": [
        "web"
      ]
    }
  },
  "scripts": {
    "build": "node plugin-src/client/build.mjs && node plugin-src/host/build.mjs",
    "test": "node scripts/run-tests.mjs",
    "check": "yarn run typecheck && yarn run build && yarn run test && yarn run verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "typecheck": "node scripts/check-syntax.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@tencent-connect/qqbot-nodejs": "1.0.4",
    "@wecom/aibot-node-sdk": "1.0.7",
    "dingtalk-stream": "2.1.4",
    "qrcode": "1.5.4",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@larksuiteoapi/node-sdk": "1.73.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "esbuild": "0.25.9",
    "https-proxy-agent": "5.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "semver": "7.8.5"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  }
}
